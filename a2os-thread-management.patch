+// Membaca bilangan bulat tak negatif (maks 4 digit). Mengembalikan -1 jika kosong,
+// mengandung karakter selain angka, atau terlalu panjang.
+static int parse_number(const char* s) {
+    if (s[0] == '\0')
+        return -1;
+
+    int value = 0;
+    for (int i = 0; s[i] != '\0'; ++i) {
+        if (s[i] < '0' || s[i] > '9' || i >= 4)
+            return -1;
+        value = value * 10 + (s[i] - '0');
+    }
+    return value;
+}
